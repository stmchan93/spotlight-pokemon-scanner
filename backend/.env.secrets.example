# Copy this file to backend/.env.staging.secrets or backend/.env.production.secrets
# for hosted deploys, or pass a different secrets path explicitly to the deploy scripts.

# Optional when your Supabase project uses asymmetric signing with JWKS.
# Required when your bearer tokens are still signed symmetrically (for example HS256).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Supabase `service_role` secret (Dashboard -> Project Settings -> API).
# REQUIRED in staging/production: "Delete Account" calls the Supabase Admin API to
# delete the auth user. Without this the local data is wiped but the LOGIN survives,
# so App Store review re-rejects under guideline 5.1.1(v). Keep this server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

SCRYDEX_API_KEY=your_scrydex_api_key
SCRYDEX_TEAM_ID=your_scrydex_team_id

# Who's That Pokemon / Claude vision (Anthropic Messages API). Leave unset to
# disable the feature (the endpoints return 503 feature_unavailable).
ANTHROPIC_API_KEY=

# Public App Store access gate. Comma-separated. Configured here (not in source)
# so the admin email + invite codes aren't baked into the public repo.
#   - Admin emails bypass the gate and see admin controls.
#   - Invite codes can be redeemed in-app to grant access (case-insensitive).
SPOTLIGHT_ACCESS_ADMIN_EMAILS=admin@example.com
SPOTLIGHT_ACCESS_INVITE_CODES=some_invite_code

# Local-dev only. Do not set this in staging/production deploy secrets.
# SPOTLIGHT_AUTH_FALLBACK_USER_ID=local-dev-user

# Optional eBay current-listings integration.
SPOTLIGHT_EBAY_BROWSE_ENABLED=1
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_MARKETPLACE_ID=EBAY_US

# Optional uptime alerting. Create a check at Healthchecks.io (period 5m, grace
# ~10m), set its notification channels, and paste its ping URL here. The 5-minute
# health cron pings it only when all checks pass; a missed ping (failure, or the
# VM is down) triggers the alert. Leave unset to disable.
# SPOTLIGHT_HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid
