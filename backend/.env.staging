SPOTLIGHT_DATABASE_PATH=/tmp/spotlight_scanner.sqlite
SPOTLIGHT_SKIP_SEED=1
SPOTLIGHT_ENABLE_LEGACY_PROVIDER_CACHE=0
SPOTLIGHT_AUTH_REQUIRED=1
SUPABASE_URL=https://lvnjshymwvagwadqeofm.supabase.co
SCRYDEX_BASE_URL=https://api.scrydex.com
# Backbone: SigLIP2-384 (cut over from CLIP v011 on 2026-06-08). The active index
# is the SigLIP2 768-dim index; MODEL_ID below selects the SigLIP2 encoder so the
# runtime loads siglip2-base-patch16-384_vision_fp32.onnx (auto torch fallback).
SPOTLIGHT_VISUAL_MODEL_ID=google/siglip2-base-patch16-384
SPOTLIGHT_VISUAL_INDEX_NPZ_PATH=backend/data/visual-index/visual_index_active_siglip2-base-patch16-384.npz
SPOTLIGHT_VISUAL_INDEX_MANIFEST_PATH=backend/data/visual-index/visual_index_active_manifest.json
SPOTLIGHT_VISUAL_ADAPTER_CHECKPOINT_PATH=backend/data/visual-models/raw_visual_adapter_active.pt
SPOTLIGHT_VISUAL_ADAPTER_METADATA_PATH=backend/data/visual-models/raw_visual_adapter_active_metadata.json
# The runtime scanner uses the FP32 ONNX CLIP encoder by default (numerically
# identical to torch, faster on CPU; auto-falls back to torch if the artifact is
# missing). Set SPOTLIGHT_VISUAL_ENCODER_BACKEND=torch to force torch.
# See docs/clip-encoder-onnx-quantization-findings-2026-05-26.md.
SPOTLIGHT_VISUAL_ONNX_INTRA_OP_THREADS=2
SPOTLIGHT_VISUAL_ONNX_INTER_OP_THREADS=1
# User-photo rerank (stage 2): boost shortlisted cards by similarity to confirmed
# real scans, closing the pristine-reference vs real-capture gap. Threshold 0.80
# captures the full covered-card lift (top-1 39->67 on the leave-one-out eval) at
# the cost of -1 held-out top-1 on an effectively-unfindable card. Curated pool
# (outlier gate + per-card cap + averaged prototype, built by
# tools/build_user_photo_rerank_pool.py). The pool is DATE-versioned (its own
# artifact family, unrelated to the model/adapter version) so it never collides
# with adapter version numbers. Reverts by removing these lines or repointing the
# pool path to a prior date. Measured via tools/eval_rerank_with_user_photos.py.
SPOTLIGHT_VISUAL_USER_PHOTO_RERANK=1
# Threshold lowered to 0.30 for the SigLIP2 backbone (its adapter-space cosine
# scale runs lower than CLIP's; validated via leave-one-out, robust 0.0-0.7).
SPOTLIGHT_VISUAL_USER_PHOTO_RERANK_THRESHOLD=0.30
# alpha 0.10 with the v011-space pool (20260605c-v011). Swept 2026-06-05 on the
# v011 pool: alpha 0.10/thresh 0.80 lifts covered-card leave-one-out top-1
# 40%->48% (80->96/202) with the holdout guard flat at 11/71 (NO regression).
# 0.05 (the old v010-era value) was under-powered here; gain saturates ~0.10
# (0.20 adds only +1). Revert: set back to 0.05 or remove (code default 0.1).
SPOTLIGHT_VISUAL_USER_PHOTO_RERANK_ALPHA=0.10
# Pool rebuilt in SigLIP2-384 adapter space (768-dim) on 2026-06-08 — must match
# the active adapter, else pool and query embeddings are in different spaces and
# the boost is meaningless. Built by tools/build_user_photo_rerank_pool.py
# --model-id google/siglip2-base-patch16-384.
SPOTLIGHT_VISUAL_USER_PHOTO_RERANK_POOL_NPZ_PATH=backend/data/visual-index/visual_index_user_photos_rerank_pool_20260608-siglip2_siglip2-base-patch16-384.npz
SPOTLIGHT_VISUAL_USER_PHOTO_RERANK_POOL_MANIFEST_PATH=backend/data/visual-index/visual_index_user_photos_rerank_pool_20260608-siglip2_manifest.json
# Phase 2 collector-number tiebreak (SECONDARY verification only). Nudges a
# same-art/different-number lookalike candidate up when the OCR'd footer
# collector number matches and the visual top-1/top-2 gap is a near-tie. It is
# NEVER a primary identifier and NEVER a hard filter. Leave OFF here: it is a
# no-op until the client forwards the footer collector number, and it MUST be
# latency-measured on a real device (on-device ML Kit OCR runs concurrently with
# the network match) before being enabled on staging.
# SPOTLIGHT_VISUAL_COLLECTOR_TIEBREAK=1
# SPOTLIGHT_VISUAL_COLLECTOR_TIEBREAK_MARGIN=0.03
# SPOTLIGHT_VISUAL_COLLECTOR_TIEBREAK_BETA=0.04
SPOTLIGHT_SCAN_ARTIFACT_UPLOADS_ENABLED=true
SPOTLIGHT_SCAN_ARTIFACTS_STORAGE=gcs
SPOTLIGHT_SCAN_ARTIFACTS_GCS_BUCKET=looty-staging
# Optional. Enable live eBay current listings for card detail.
# Put credentials in the deploy secrets file (for example backend/.env) passed to
# backend/deploy_to_vm.sh, and set the flag either here or in that secrets file.
SPOTLIGHT_EBAY_BROWSE_ENABLED=1
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Phase 4: read price HISTORY from the normalized cell table (parity-verified) instead of JSON blobs.
PRICE_HISTORY_SOURCE=cells

# Startup dashboard prewarm: ENABLED. Warms the exact cache keys clients request
# (dashboard 1W, deck entries, performance) per owner at boot AND after the daily
# price sync (via /api/v1/ops/prewarm-portfolio in run_sync_vm.sh), so the first
# user per owner after a sync/reboot gets a ~1ms hit instead of a ~25s cold
# recompute. Re-enabled 2026-07-06 (was off since 2026-06-10 pending DB shrink).
PORTFOLIO_DASHBOARD_PREWARM=1
