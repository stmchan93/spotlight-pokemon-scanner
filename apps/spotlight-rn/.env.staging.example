# Public runtime config bundled into the Expo app.
# Staging should point at your hosted staging backend.
EXPO_PUBLIC_SPOTLIGHT_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_SPOTLIGHT_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SPOTLIGHT_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_SPOTLIGHT_AUTH_REDIRECT_URL=spotlight://login-callback
EXPO_PUBLIC_SPOTLIGHT_AUTH_SCHEME=spotlight
EXPO_PUBLIC_SPOTLIGHT_POSTHOG_API_KEY=
EXPO_PUBLIC_SPOTLIGHT_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SPOTLIGHT_POSTHOG_ENABLED=1

# Native identifiers used by app.config.js.
SPOTLIGHT_IOS_BUNDLE_IDENTIFIER=com.yourcompany.spotlight
SPOTLIGHT_ANDROID_PACKAGE=com.yourcompany.spotlight
SPOTLIGHT_EXPO_OWNER=your-expo-account

# Recommended once the Expo project exists.
SPOTLIGHT_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional if you want a scheme different from the default "spotlight".
SPOTLIGHT_APP_SCHEME=spotlight

# Guest mode mints its Supabase anonymous user on the FIRST SCAN, not on app
# open (each anonymous user is a billable Supabase MAU). Defaults on; set to 0
# only as an emergency rollback to minting at launch.
# EXPO_PUBLIC_SPOTLIGHT_DEFER_GUEST_SESSION=1

# Native Google sign-in (build-time; see docs/native-google-sign-in-plan-2026-11-21.md).
# Unset = the app keeps the browser Google flow. GOOGLE_IOS_CLIENT_ID is this
# environment's iOS OAuth client (its reversed form becomes the iOS URL scheme);
# GOOGLE_WEB_CLIENT_ID is the Web client Supabase's Google provider uses.
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_WEB_CLIENT_ID=
