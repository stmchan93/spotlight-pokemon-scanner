# Local development config. Copy to .env.development and fill in real values.
# cp apps/spotlight-rn/.env.development.example apps/spotlight-rn/.env.development
#
# To test against the staging backend instead of local, either:
#   a) Set EXPO_PUBLIC_SPOTLIGHT_API_BASE_URL to the staging URL below, or
#   b) Run:  EXPO_PUBLIC_SPOTLIGHT_API_BASE_URL=https://looty.34.59.188.129.sslip.io pnpm dev:mobile

# Local backend (default). Change to staging URL to test against staging.
EXPO_PUBLIC_SPOTLIGHT_API_BASE_URL=http://127.0.0.1:8788

# looty-staging. Local dev must NEVER point at the production project
# (lvnjshymwvagwadqeofm) — that is where the real user accounts live.
EXPO_PUBLIC_SPOTLIGHT_SUPABASE_URL=https://mphjenaaorntwkyivqtm.supabase.co
EXPO_PUBLIC_SPOTLIGHT_SUPABASE_ANON_KEY=sb_publishable_tHLxhYJbYDtBo2Pokx6tKg_wY6PBmfi
EXPO_PUBLIC_SPOTLIGHT_AUTH_REDIRECT_URL=spotlight://login-callback
EXPO_PUBLIC_SPOTLIGHT_AUTH_SCHEME=spotlight
EXPO_PUBLIC_SPOTLIGHT_POSTHOG_API_KEY=
EXPO_PUBLIC_SPOTLIGHT_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SPOTLIGHT_POSTHOG_ENABLED=0

SPOTLIGHT_IOS_BUNDLE_IDENTIFIER=com.ekalight.app.dev
SPOTLIGHT_ANDROID_PACKAGE=com.ekalight.app.dev
SPOTLIGHT_EXPO_OWNER=schan93
SPOTLIGHT_EAS_PROJECT_ID=bd29d8aa-8a70-45ba-907e-f7136f2be4ff
SPOTLIGHT_APP_SCHEME=spotlight

# Guest mode mints its Supabase anonymous user on the FIRST SCAN, not on app
# open (each anonymous user is a billable Supabase MAU). Defaults on; set to 0
# only as an emergency rollback to minting at launch.
# EXPO_PUBLIC_SPOTLIGHT_DEFER_GUEST_SESSION=1
