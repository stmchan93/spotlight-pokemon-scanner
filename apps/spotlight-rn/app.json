{
  "expo": {
    "name": "Ekalight",
    "slug": "looty",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotlight",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/ekalight.icon",
      "bundleIdentifier": "com.ekalight.app.staging",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Ekalight to use your camera to scan cards.",
        "NSMicrophoneUsageDescription": "Allow Ekalight to access your microphone.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.ekalight.app.staging",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "0.1.2",
    "updates": {
      "url": "https://u.expo.dev/bd29d8aa-8a70-45ba-907e-f7136f2be4ff"
    },
    "extra": {
      "eas": {
        "projectId": "bd29d8aa-8a70-45ba-907e-f7136f2be4ff"
      }
    }
  }
}
