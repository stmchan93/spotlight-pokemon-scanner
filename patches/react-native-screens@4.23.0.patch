     private val context: ContextThemeWrapper,
     private val bottomNavigationView: BottomNavigationView,
 ) {
+    /**
+     * A hidden bar must also be UNTOUCHABLE.
+     *
+     * `isVisible = false` sets the bar GONE, and on stock Android that alone
+     * keeps touches away from it. In practice it did not: on a Galaxy A17
+     * (Android 16 / One UI 8.5) the GONE bar kept its last layout rect at the
+     * bottom of the screen and its menu items stayed VISIBLE, ENABLED and
+     * CLICKABLE, and every touch landing in that rect went to an invisible tab
+     * item — silently, since the bar was "hidden" — instead of the React view
+     * drawn over it. Android lets a GONE view receive pointer events whenever
+     * it still carries an Animation, and a lingering one is enough.
+     *
+     * So when hidden: clear any animation on the bar and its menu view, and
+     * make the bar, the menu and every item non-clickable and non-focusable,
+     * so no dispatch path can land on them. When shown again, restore the
+     * flags; Material re-inflates items with the defaults regardless.
+     */
+    private fun applyHiddenTouchability(hidden: Boolean) {
+        val touchable = !hidden
+        fun apply(view: android.view.View) {
+            if (hidden) view.clearAnimation()
+            view.isClickable = touchable
+            view.isFocusable = touchable
+        }
+        apply(bottomNavigationView)
+        bottomNavigationView.children.forEach { menu ->
+            apply(menu)
+            (menu as? ViewGroup)?.children?.forEach { item -> apply(item) }
+        }
+    }
+
     private fun resolveColorAttr(attr: Int): Int {
         val typedValue = TypedValue()
         context.theme.resolveAttribute(attr, typedValue, true)
