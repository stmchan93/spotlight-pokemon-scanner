# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata

# Build artifacts  
build/
DerivedData/
.derivedData/
.derivedData-*/
.build/
*.ipa
*.dSYM.zip
*.dSYM

# Swift module cache
.swift-module-cache/
*.swift-module-cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Google Play service-account key (used by `eas submit -p android`)
apps/spotlight-rn/credentials/

# Backend Python
.env
__pycache__/
*.py[cod]
backend/__pycache__/
backend/*.pyc
backend/venv/
backend/.env
backend/.env.*.secrets
# ...and any backup/rotation copy of a secrets file (e.g. .secrets.bak-<reason>).
# The bare rule above does NOT match a suffixed copy, so one made during a
# credential rotation would otherwise show up as an untracked, committable file.
backend/.env.*.secrets.*
.venv-raw-visual-poc/
.env.*.smoke.local

# Backend databases
backend/data/*.sqlite
backend/data/*.db
backend/data/*.sqlite-*
backend/data/*.sqlite.bak.*
backend/data/visual-index/
backend/data/visual-models/

# Rerank-pool flywheel runtime state (known-good marker, watermark, review queue) — mutates each run
tools/state/

# Generated QA caches
qa/raw-visual-train
qa/raw-visual-train-excluded
qa/raw-footer-layout-check/.visual_reference_cache
qa/raw-footer-layout-check/.visual_reference_cache/
qa/raw-visual-train/
qa/raw-visual-train-excluded/

# Logs
*.log
.coverage
backend/logs/

# JavaScript / Expo / pnpm
node_modules/
.pnpm-store/
coverage/
dist/
.expo/prebuild/
apps/spotlight-rn/.expo/
apps/spotlight-rn/.eas/
apps/spotlight-rn/.metro-health-check*
apps/spotlight-rn/.maestro/*.mp4
apps/spotlight-rn/.maestro/*.png
apps/spotlight-rn/.maestro/logs/
apps/spotlight-rn/junit.xml

# Local Xcode environment overrides
Spotlight/Config/LocalOverrides.xcconfig

# Claude/temp files
.claude/
.tmp/
*.tmp
.scanner_eval
.vision_featureprint_check
tmp/

# Local smoke artifacts
backend/data/scan-artifacts/labeling-sessions/
# Private scan captures are runtime/local only — never commit them (repo invariant).
backend/data/scan-artifacts/scans/
staging-smoke-*.png

# Xcode user state
*.xcuserstate
*.xcodeproj/xcuserdata/

# generated audit/output artifacts from tools/ scripts
tools/output/

# Lazily-downloaded ONNX model artifacts (person_cutout u2netp etc.)
backend/models/

# Supabase CLI local link cache
apps/spotlight-rn/supabase/.temp/

# Stray Supabase CLI link state when a command is run from the repo root
# without --workdir (the real project lives in apps/spotlight-rn/supabase).
/supabase/.temp/

# /sync-design screenshot + diff artifacts (see .claude/commands/sync-design.md)
.design-sync/

# Figma personal access token for design-sync (never commit)
.env.figma
